{% extends 'base.html.twig' %}

{% block title %}AllGames — Home{% endblock %}

{% block body %}
<section class="text-gray-400 bg-gray-900 body-font">
    <div class="container mx-auto flex px-5 py-24 md:flex-row flex-col items-center">
        <div class="lg:flex-grow md:w-1/2 lg:pr-24 md:pr-16 flex flex-col md:items-start md:text-left mb-16 md:mb-0 items-center text-center">
            <h1 class="title-font sm:text-4xl text-3xl mb-4 font-medium text-white">
                Discover, wishlist and review<br class="hidden lg:inline-block">your favorite games
            </h1>
            <p class="mb-8 leading-relaxed">AllGames brings together the best games from every editor and genre. Build your wishlist, share your reviews and find your next favorite game.</p>
            <div class="flex justify-center">
                <a href="{{ path('app_game_list') }}" class="inline-flex text-white bg-blue-500 border-0 py-2 px-6 focus:outline-none hover:bg-blue-600 rounded text-lg">Browse games</a>
                <a href="{{ path('app_about') }}" class="ml-4 inline-flex text-gray-400 bg-gray-800 border-0 py-2 px-6 focus:outline-none hover:bg-gray-700 hover:text-white rounded text-lg">Learn more</a>
            </div>
        </div>
        <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6">
            <img class="object-contain object-center" alt="AllGames" src="{{ asset('images/big-logo-all-games.svg') }}">
        </div>
    </div>
</section>

<section class="text-gray-400 bg-gray-900 body-font">
    <div class="container px-5 py-12 mx-auto">
        <div class="flex flex-col text-center w-full mb-8">
            <h2 class="text-xs text-blue-500 tracking-widest font-medium title-font mb-1">LATEST RELEASES</h2>
            <h1 class="sm:text-3xl text-2xl font-medium title-font text-white">Newest games</h1>
        </div>
        <div class="flex flex-wrap -m-4">
            {% for game in games %}
                {{ include('game/_game_item.html.twig') }}
            {% else %}
                <p class="p-4">No games yet.</p>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
