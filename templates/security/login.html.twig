{% extends 'base.html.twig' %}

{% block title %}AllGames — Login{% endblock %}

{% block body %}
<section class="text-gray-400 bg-gray-900 body-font">
    <div class="container px-5 py-24 mx-auto flex flex-wrap items-center justify-center">
        <form method="post" class="lg:w-1/3 md:w-1/2 bg-gray-800 rounded-lg p-8 flex flex-col w-full">
            <h2 class="text-white text-lg font-medium title-font mb-5">Sign in</h2>

            {% if error %}
                <div class="bg-red-900 text-red-200 rounded p-3 mb-4 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3 text-sm">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="text-blue-500">Logout</a>
                </div>
            {% endif %}

            <div class="relative mb-4">
                <label for="username" class="leading-7 text-sm text-gray-400">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus
                       class="w-full bg-gray-900 rounded border border-gray-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-900 text-base outline-none text-gray-100 py-1 px-3 leading-8">
            </div>

            <div class="relative mb-4">
                <label for="password" class="leading-7 text-sm text-gray-400">Password</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required
                       class="w-full bg-gray-900 rounded border border-gray-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-900 text-base outline-none text-gray-100 py-1 px-3 leading-8">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="text-white bg-blue-500 border-0 py-2 px-6 focus:outline-none hover:bg-blue-600 rounded text-lg">Sign in</button>
        </form>
    </div>
</section>
{% endblock %}
