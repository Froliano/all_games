<div class="p-4 md:w-1/3">
    <div class="h-full border-2 border-gray-800 rounded-lg overflow-hidden">
        <img class="lg:h-48 md:h-36 w-full object-cover object-center" src="{% if game.imageName %}{{ vich_uploader_asset(game, 'imageFile') }}{% else %}https://dummyimage.com/1205x505{% endif %}" alt="{{ game.name }}">
        <div class="p-6">
            <h2 class="tracking-widest text-xs title-font font-medium text-gray-500 mb-1">
                {% for genre in game.genres %}{{ genre.name }}{% if not loop.last %}, {% endif %}{% endfor %}
            </h2>
            <h1 class="title-font text-lg font-medium text-white mb-3">{{ game.name }}</h1>
            <p class="leading-relaxed mb-3">{{ game.description|slice(0, 120) }}{% if game.description|length > 120 %}...{% endif %}</p>
            <div class="flex items-center flex-wrap">
                <a href="{{ path('app_game_show', {'id': game.id}) }}" class="text-blue-500 inline-flex items-center md:mb-2 lg:mb-0">Learn More
                    <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path>
                        <path d="M12 5l7 7-7 7"></path>
                    </svg>
                </a>
                <span class="text-gray-500 mr-3 inline-flex items-center lg:ml-auto md:ml-0 ml-auto leading-none text-sm pr-3 py-1">
                    {{ game.releaseDate|date('Y') }}
                </span>
            </div>
        </div>
    </div>
</div>
